{
  "name": "@rekstack/mui-form",
  "version": "1.0.0-beta.36",
  "description": "A collection of Material UI form inputs designed for seamless integration with React Hook Form.",
  "author": {
    "name": "Rui Araújo"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RekStack/mui-form.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ruiaraujo012"
  },
  "type": "module",
  "packageManager": "pnpm@9.6.0",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "rimraf ./dist && tsc && vite build && publint --strict",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "cipublish": "node scripts/publish.js"
  },
  "keywords": [
    "react",
    "react-hook-form",
    "mui",
    "material-ui",
    "form",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^6.1.1",
    "@mui/x-date-pickers": "^7.18.0",
    "@rekstack/eslint-react": "1.0.0-beta.35",
    "@rekstack/prettier": "1.0.0-beta.16",
    "@tanstack/config": "^0.13.3",
    "@types/node": "^22.6.1",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "eslint": "^9.11.1",
    "mui-tel-input": "^6.0.1",
    "publint": "^0.2.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.7",
    "vite-plugin-eslint": "^1.8.1"
  },
  "peerDependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/material": "^6.1.1",
    "@mui/x-date-pickers": "^7.18.0",
    "mui-tel-input": "^6.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.4"
  }
}
